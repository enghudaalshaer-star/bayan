rules_version = '2';
// بيان — قواعد Firebase Storage
// library/{courseId}/…  : مرفقات المواد — يرفعها ويحذفها المشرف، ويقرؤها المسجّل في المادة فقط (حد 200 م.ب، يطابق ATT_MAX في core.js)
// apps/{uid}/{program}.jpg : صورة مؤهل طلب الالتحاق — يرفعها صاحبها (صورة حتى 3 م.ب)، ويقرؤها هو والمشرف فقط
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function enrolled(courseId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }
    match /library/{courseId}/{file} {
      allow get: if isAdmin() || enrolled(courseId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /apps/{uid}/{file} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && file.matches('(academy|ijaza)[.]jpg')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /{all=**} { allow read, write: if false; }
  }
}
