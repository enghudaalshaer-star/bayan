rules_version = '2';
// بيان — قواعد Firebase Storage: مرفقات الدروس والمواد (library/{courseId}/…)
// الرفع والحذف للمشرف فقط (حسابه في مجموعة admins بـ Firestore)، والقراءة لأي مستخدم مسجّل الدخول.
// الحد الأقصى للملف 200 ميغابايت (يطابق ATT_MAX في core.js).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /library/{courseId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /{all=**} { allow read, write: if false; }
  }
}
